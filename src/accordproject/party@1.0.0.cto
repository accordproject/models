concerto version "^3.0.0"

namespace org.accordproject.party@1.0.0

/**
 * A party to an agreement.
 *
 * Party is registry-resident: it is the target of relationships from models
 * which can assume a resolver, such as agreement@1.0.0.
 */
participant Party identified by partyId {
  o String partyId
  o String name optional
}

/**
 * A portable, self-contained projection of a Party.
 *
 * PartyRef is the serializable form used by records which must travel
 * standalone and therefore cannot assume a registry: obligations, attestations
 * and settlement evidence. scheme names the identifier authority, for example
 * "did", "lei" or "email", so that id can be resolved without ambiguity.
 *
 * A PartyRef with scheme "party" and id equal to Party.partyId denotes the
 * corresponding Party in the same deployment.
 */
concept PartyRef {
  o String id
  o String scheme
  o String label optional
}
